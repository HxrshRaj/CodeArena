# ---------------------------------------------------------------------------
# CodeArena environment. Copy to .env and adjust as needed.
# ---------------------------------------------------------------------------

# Postgres (docker compose exposes it on 5434 to avoid clashing with a local pg)
DATABASE_URL="postgresql://codearena:codearena@localhost:5434/codearena?schema=public"

# Redis (docker compose exposes it on 6380)
REDIS_URL="redis://localhost:6380"

# REST API + WebSocket gateway
API_PORT=4000
API_HOST=0.0.0.0

# Next.js dev server port (3000 is often taken; keep this clear of it)
WEB_PORT=3100

# Public URL the browser uses to reach the API/WS (used by the Next.js app)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"

# ---------------------------------------------------------------------------
# Sandbox execution
# ---------------------------------------------------------------------------
SANDBOX_IMAGE="codearena-sandbox-python:latest"
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
# Concurrent submissions a single executor worker will run at once
EXECUTOR_CONCURRENCY=2

# ---------------------------------------------------------------------------
# LLM code-review layer (kept entirely separate from deterministic scoring)
# ---------------------------------------------------------------------------
# Provider: "anthropic" | "openai" | "stub"
# "stub" runs the full queue/table/UI path with a canned response and no API call.
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
